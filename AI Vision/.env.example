# Copy this file to ".env" and edit. ".env" is git-ignored.
#
# Only needed if Tesseract is NOT on your PATH and NOT in the default
# Windows install folder. Leave it empty to use automatic detection.
#
# Windows example (default installer location):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
